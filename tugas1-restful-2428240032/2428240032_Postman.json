              "});",
              "",
              "pm.test('respons memiliki data stok dengan id 1', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('object');",
              "    pm.expect(body.id).to.eql(1);",
              "    pm.expect(body).to.have.property('golonganDarah');",
              "});"
