    {
      "name": "04 - get filter golongan darah",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blood-stocks?golonganDarah=O",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blood-stocks"
          ],
          "query": [
            {
              "key": "golonganDarah",
              "value": "O"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status filter berhasil 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('semua data hasil filter bergolongan O', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "    body.forEach(function (stock) {",
              "        pm.expect(stock.golonganDarah).to.eql('O');",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - post data lengkap",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"golonganDarah\": \"AB\",\n  \"rhesus\": \"+\",\n  \"jumlahKantong\": 20,\n  \"lokasi\": \"Muhammad Luthfi Hilmy 2428240032\",\n  \"tanggalUpdate\": \"2026-10-21\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/blood-stocks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blood-stocks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status data berhasil dibuat 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('respons POST memiliki data stok baru', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('success');",
              "    pm.expect(body.data).to.be.an('object');",
              "    pm.expect(body.data).to.have.property('id');",
              "    pm.expect(body.data.lokasi).to.include('2428240032');",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.environment.set('created_id', response.data.id);"
            ]
          }
        }
      ]
    },
