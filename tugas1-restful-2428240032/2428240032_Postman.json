  "item": [
    {
      "name": "00 - get informasi api",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status informasi API adalah 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('respons informasi API memiliki identitas dan endpoint', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('nama');",
              "    pm.expect(body).to.have.property('nim');",
              "    pm.expect(body.nim).to.eql('2428240032');",
              "    pm.expect(body).to.have.property('endpoints');",
              "    pm.expect(body.endpoints).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - get seluruh data",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blood-stocks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blood-stocks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status berhasil 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('respons berupa array stok darah', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "    if (body.length > 0) {",
              "        pm.expect(body[0]).to.have.property('id');",
              "        pm.expect(body[0]).to.have.property('golonganDarah');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
